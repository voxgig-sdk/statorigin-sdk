# Entity: source

main: kit: entity: source: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Stable prefixed identifier."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      t: "`$STRING`"
    }
    short_name: {
      h: "Short Name"
      n: "short_name"
      r: false
      t: "`$STRING`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: false
      sh: "URL key: the item routes take this."
      t: "`$STRING`"
    }
    tier: {
      h: "Tier"
      n: "tier"
      r: false
      t: "`$INTEGER`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "slug"
    name: "id"
  }

  name: "source"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /sources"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "tier"
                or: "tier"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/sources"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "sources"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /sources/{slug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "international-energy-agency"
                k: "param"
                n: "id"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 100
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/sources/{slug}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              slug: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "sources"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
