      t: "`$STRING`"
    }
    unit: {
      h: "Unit"
      n: "unit"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "slug"
    name: "id"
  }

  name: "indicator"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /indicators"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "industry"
                or: "industry"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/indicators"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "indicators"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /indicators/{slug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "global-ev-annual-sales"
                k: "param"
                n: "id"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/indicators/{slug}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              slug: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "indicators"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          co: {
            id: "GET /indicators/{slug}/series"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "global-ev-annual-sales"
                k: "param"
                n: "slug"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 2015
                k: "query"
                n: "from"
                or: "from"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "region"
                or: "region"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 2026
                k: "query"
                n: "to"
                or: "to"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/indicators/{slug}/series"
          q: {
            "$action": "series"
            exist: [
              "slug"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "indicators"
            }
            {
              var: "slug"
            }
            {
              lit: "series"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
